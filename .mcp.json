{
  "mcpServers": {
    "colgrep": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/server",
        "colgrep-mcp"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "COLGREP_MCP_ROOT": "${CLAUDE_PROJECT_DIR}",
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/Users/hacker/.local/bin:/Users/hacker/.cargo/bin"
      }
    }
  }
}
